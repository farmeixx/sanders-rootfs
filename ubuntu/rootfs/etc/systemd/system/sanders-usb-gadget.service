[Unit]
Description=Moto G5S Plus USB RNDIS gadget for headless SSH
After=systemd-modules-load.service sys-kernel-config.mount local-fs.target
Wants=sys-kernel-config.mount
Before=network.target ssh.service sanders-dhcp.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/sanders-usb-gadget
RemainAfterExit=yes
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
